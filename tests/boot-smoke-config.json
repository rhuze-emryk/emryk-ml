{
  "customizations": {
    "user": [
      {
        "name": "ci-smoke",
        "password": "__GENERATED_AT_RUNTIME__",
        "groups": [
          "wheel"
        ]
      }
    ],
    "kernel": {
      "append": "console=ttyS0,115200n8 systemd.mask=emryk-install-flatpaks.service systemd.default_device_timeout_sec=300"
    },
    "filesystem": [
      {
        "mountpoint": "/",
        "minsize": "20 GiB"
      },
      {
        "mountpoint": "/boot",
        "minsize": "2 GiB"
      }
    ]
  }
}
