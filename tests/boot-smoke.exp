#!/usr/bin/expect -f

if {$argc != 5} {
    puts stderr "usage: boot-smoke.exp DISK OVMF_VARS PASSWORD VARIANT EXPECTED_SOURCE"
    exit 2
}

set disk [lindex $argv 0]
set ovmf_vars [lindex $argv 1]
set password [lindex $argv 2]
set variant [lindex $argv 3]
set expected_source [lindex $argv 4]
set guest_script [file join [file dirname [info script]] boot-smoke-guest.sh]
set guest_payload [exec base64 -w0 $guest_script]
# accel=kvm:tcg — QEMU tries the accelerators in order: KVM when the runner
# exposes a writable /dev/kvm (GitHub-hosted Linux runners have since 2024;
# the workflow grants access), otherwise TCG software emulation. TCG is far
# slower — F45 guest boots took 4-5 minutes of userspace and udev needed
# ~45 s to surface /boot — so the 60-minute timeout is the TCG budget for
# the whole boot + guest checks, not the expected KVM duration.
set timeout 3600

if {![info exists env(SERIAL_LOG)]} {
    puts stderr "SERIAL_LOG is required"
    exit 2
}
log_file -a $env(SERIAL_LOG)

spawn qemu-system-x86_64 \
    -machine q35,accel=kvm:tcg \
    -cpu max \
    -smp 2 \
    -m 4096 \
    -nographic \
    -no-reboot \
    -device virtio-rng-pci \
    -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd \
    -drive if=pflash,format=raw,file=$ovmf_vars \
    -drive if=virtio,format=qcow2,file=$disk \
    -netdev user,id=network0 \
    -device virtio-net-pci,netdev=network0

# A boot that lands in the emergency or rescue shell never shows a login
# prompt (2026-11-01 F45 intel leg: /boot device timeout under TCG, then an
# hour of waiting for "login:"). Fail now; the serial log holds the reason.
expect {
    -re {login:[[:space:]]*$} {}
    -re {You are in (emergency|rescue) mode|Give root password for maintenance|Press Enter for maintenance} {
        puts stderr "VM dropped into the emergency/rescue shell instead of presenting a login prompt"
        exit 1
    }
    timeout {
        puts stderr "timed out waiting for the serial login prompt"
        exit 124
    }
    eof {
        puts stderr "VM exited before presenting a serial login prompt"
        exit 1
    }
}
send -- "ci-smoke\r"
expect -re {Password:[[:space:]]*$}
send -- "$password\r"
expect -re {[$#][[:space:]]*$}

send -- "printf '%s' '$guest_payload' | base64 -d > /tmp/emryk-boot-smoke.sh\r"
expect -re {[$#][[:space:]]*$}
send -- "sudo -S bash /tmp/emryk-boot-smoke.sh '$expected_source' '$variant'\r"
expect {
    -re {\[sudo\] password for ci-smoke:[[:space:]]*$} {
        send -- "$password\r"
        exp_continue
    }
    -re {EMRYK_SMOKE_OK} {}
    -re {EMRYK_SMOKE_FAILED:([0-9]+)} {
        puts stderr "guest smoke checks failed"
        exit 1
    }
    timeout {
        puts stderr "timed out waiting for guest smoke checks"
        exit 124
    }
    eof {
        puts stderr "VM exited during guest smoke checks"
        exit 1
    }
}

expect -re {[$#][[:space:]]*$}
send -- "sudo -S systemctl poweroff\r"
# Shutdown is cleanup, not an assertion: the smoke checks have already
# passed. sudo's credential cache from the earlier check run may have
# expired (slow guest checks under emulation), so answer a fresh password
# prompt here too. Bound the wait so a wedged poweroff costs minutes, not
# the remaining 60-minute budget, and never fails a leg whose checks passed.
set timeout 600
expect {
    -re {\[sudo\] password for ci-smoke:[[:space:]]*$} {
        send -- "$password\r"
        exp_continue
    }
    eof {}
    timeout {
        puts stderr "warning: VM did not power off within 10 minutes; exiting after passed checks"
    }
}
