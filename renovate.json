{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Etc/UTC",
  "schedule": [
    "every weekend",
    "before 9am on monday"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "rhuze-emryk"
  ],
  "assignees": [
    "rhuze-emryk"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Let new *version* releases settle ~3 days before a PR opens, to dodge yanked or broken releases. Does NOT match 'digest' updates, so container base-image digest refreshes still follow the weekly schedule + green-CI auto-merge below. Security updates bypass this via vulnerabilityAlerts.",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Pin every GitHub Action by full commit SHA.",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Pin every container base image by digest.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Hold cosign below v3.1: v3.1.x removed explicit legacy key-attachment selection and cannot verify these images when keyless OCI attestation bundles coexist. Re-evaluate with a live signature-policy rehearsal before lifting.",
      "matchPackageNames": [
        "sigstore/cosign"
      ],
      "allowedVersions": "<3.1.0"
    },
    {
      "description": "Auto-merge container base-image digest refreshes once CI is green. The kernel<->akmods coupling check in build.yml is the safety interlock: a kinoite-main bump that moves the kernel fails until the akmods tag is updated. Tag/version changes are never auto-merged. Customer machines fetch and stage without rebooting.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track GRYPE_VERSION against anchore/grype releases.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "GRYPE_VERSION:\\s*[\"']?(?<currentValue>v[^\"'\\s]+)[\"']?"
      ],
      "depNameTemplate": "anchore/grype",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track SYFT_VERSION against anchore/syft releases.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "SYFT_VERSION:\\s*[\"']?(?<currentValue>v[^\"'\\s]+)[\"']?"
      ],
      "depNameTemplate": "anchore/syft",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track the digest-pinned bootc-image-builder used by workflows and the Justfile.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^Justfile$/"
      ],
      "matchStrings": [
        "(?:BIB_IMAGE:|builder-image:|bib_image := env\\(\\\"BIB_IMAGE\\\",)\\s*\\\"?quay\\.io/centos-bootc/bootc-image-builder:(?<currentValue>[^@\\\"\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "quay.io/centos-bootc/bootc-image-builder",
      "datasourceTemplate": "docker"
    }
  ]
}
